NODE_ENV=development
PORT=5000

# Use a PostgreSQL connection string for production.
DATABASE_URL=postgresql://user:password@host:5432/job_portal?sslmode=require

# Generate a random value with at least 32 characters; store it only in the host's secret settings.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000

# Private S3-compatible object storage for uploaded resumes (AWS S3, Cloudflare R2, etc.).
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=job-portal-resumes
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
